{
  "name": "schoolsphere-monorepo",
  "version": "1.0.0",
  "description": "SchoolSphere — Premium School Management System (Full-Stack Monorepo)",
  "private": true,
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "npm --prefix backend run dev",
