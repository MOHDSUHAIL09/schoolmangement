# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Production builds
dist/
frontend/dist/
build/

# Environment configurations (NEVER commit secrets)
.env
backend/.env
backend/.env.local
frontend/.env.local

# WhatsApp Baileys Authentication state files
whatsapp_auth/
backend/whatsapp_auth/
.whatsapp_auth/

# File uploads (keep folder, ignore user uploads)
backend/uploads/*
!backend/uploads/.gitkeep

# Operating system files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
